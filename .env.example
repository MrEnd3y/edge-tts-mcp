# Nonsecret configuration template. No .env file is required or read by the server.
# Set these variables in your launcher / MCP env block. To load a local file with uv:
# uv run --env-file .env python -m edge_tts_mcp
# Docker Compose can load this optional file itself; only declared settings are
# forwarded. In Compose output is always /data/output (the mounted volume), and
# executable overrides must be Linux paths inside the container, not host paths.
# Explicit MCP request parameters override these defaults; technical tempo limits
# 0.5 <= tempo_min <= tempo_max <= 2.0 cannot be exceeded by ENV or requests.

# Server-only output directory (supports ~). Requests cannot choose another directory.
EDGE_TTS_OUTPUT_DIR=~/.edge-tts-mcp/output

# Default synthesis voice and prosody; individual MCP requests can override these.
EDGE_TTS_VOICE=ru-RU-SvetlanaNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%
EDGE_TTS_PITCH=+0Hz

# Default fitting bounds; ignored for speed changes unless a target is requested.
EDGE_TTS_TEMPO_MIN=0.5
EDGE_TTS_TEMPO_MAX=2.0

# Wall-clock operation budget, including queue, synthesis and FFmpeg/FFprobe.
# Must be finite, > 0 and <= 300 seconds. Not the length of the audio clip.
EDGE_TTS_TIMEOUT_SECONDS=45

# Default maximum length of the final audio clip, in seconds: finite and > 0.
# Independent of timeout; MCP max_audio_duration_seconds can override this default.
# Targets above this limit are rejected; oversized output is not trimmed/published.
EDGE_TTS_MAX_AUDIO_DURATION_SECONDS=300

# Executables on PATH, or absolute paths. Not required at startup:
# FFmpeg is needed for OGG/Opus or speed changes; FFprobe verifies duration fitting.
EDGE_TTS_FFMPEG=ffmpeg
EDGE_TTS_FFPROBE=ffprobe

# Server-only controls. Sidecars accept 1/0, true/false, yes/no, on/off.
EDGE_TTS_ALLOW_SIDECARS=1
# Integer 1..16; waiting for a slot uses the same operation budget.
EDGE_TTS_MAX_CONCURRENT=2
